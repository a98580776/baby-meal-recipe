# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code runtime state (not project config)
.claude/scheduled_tasks.lock

# supabase CLI local state (not project schema/data -- see supabase/migrations
# and supabase/seed.sql for those)
supabase/.temp/

# TWA signing keys (never commit — dev or release, both are secrets)
twa-build/*.keystore
twa-build/*.jks

# TWA gradle build artifacts/cache (regenerated by gradlew/bubblewrap build)
twa-build/.gradle/
twa-build/build/
twa-build/app/build/

# TWA signed build outputs (regenerated by bubblewrap build)
twa-build/*.aab
twa-build/*.apk
twa-build/*.idsig
